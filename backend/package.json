{
  "name": "smart-queue-backend",
  "version": "1.0.0",
  "description": "Smart Queue Management System for Financial Institutions in Rwanda - REST API",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:setup": "node src/db/migrate.js",
    "db:reset": "node src/db/migrate.js --reset",
    "db:demo": "node src/db/migrate.js --demo",
    "test": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
